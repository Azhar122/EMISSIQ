# ---------------------------------------------------------------------------
# EMISSIQ — environment configuration
# Copy to .env and fill in. Every value below has a working default so the
# demo runs offline with no external services.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# Local docker Postgres (default, see docker-compose.yml):
DATABASE_URL=postgresql+psycopg://emissiq:emissiq@localhost:5433/emissiq
# Supabase alternative — session pooler connection string:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# AI provider ---------------------------------------------------------------
# Order is tried left to right; the last entry is always the offline scripted
# provider so an investigation never fails during a demo.
AI_PROVIDER_ORDER=groq,ollama,scripted
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Economics -----------------------------------------------------------------
# All financial output is derived from these; nothing is hardcoded downstream.
GAS_PRICE_OMR_PER_MMBTU=1.500
CH4_ENERGY_MMBTU_PER_KG=0.05226
DISPLAY_CURRENCY=OMR
USD_PER_OMR=2.6008
GWP100_CH4=29.8
GWP20_CH4=82.5

# Frontend ------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000
